{
    "type": "module",
    "version": "1.2.3",
    "name": "tungnt-ai-skills",
    "description": "tungnt-ai-skills skills and runtime bootstrap for coding agents",
    "main": ".opencode/plugins/tungnt-ai-skills.js",
    "bin": {
        "tungnt-ai-skills": "./bin/tungnt-ai-skills.js"
    },
    "keywords": [
        "pi-package",
        "skills",
        "tdd",
        "debugging",
        "collaboration",
        "workflow"
    ],
    "pi": {
        "extensions": [
            "./.pi/extensions/tungnt-ai-skills.ts"
        ],
        "skills": [
            "./skills"
        ]
    },
    "scripts": {
        "test:installer": "node tests/installer/run-tests.js",
        "test:copilot-bootstrap": "node tests/copilot-bootstrap/run-tests.js",
        "test:skills": "node scripts/validate-skill-structure.mjs && node tests/skill-content/run-tests.js",
        "test:skill-structure": "node scripts/validate-skill-structure.mjs",
        "test:policy": "node tests/hooks.test.js"
    }
}
