#!/usr/bin/env bash
# UserPromptSubmit / PreToolUse hook: remind agent to follow using-tungnt-ai-skills routing.
# Platform-aware:
# - Claude Code (UserPromptSubmit): SessionStart injected full bootstrap, remind softly.
# - Copilot CLI (userPromptSubmitted): nothing persists, require explicit reload.
# - Cursor (beforeSubmitPrompt): nothing persists, require explicit reload.
# - Antigravity PreToolUse: inject bootstrap summary via injectSteps so model knows
#   how to call Skill tool on subsequent turns without full bootstrap context.

set -euo pipefail

stdin_payload="$(cat || true)"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Detect Antigravity PreToolUse: has toolCall field, no hookEventName
if printf '%s' "$stdin_payload" | grep -q '"toolCall"'; then
    # Antigravity PreToolUse - must return decision (allow/deny), not injectSteps.
    # Allow the tool call; context injection is handled by PreInvocation.
    printf '{\n  "decision": "allow"\n}\n'
    exit 0
fi

# Detect event type from payload
hook_event=$(printf '%s' "$stdin_payload" | sed -n 's/.*"hookEventName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)

# Claude Code UserPromptSubmit: bootstrap persists, soft reminder
if [ "$hook_event" = "UserPromptSubmit" ] || [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    session_context="Your tungnt-ai-skills bootstrap skill content was injected at session start and remains in your context. Follow its routing rules before responding or taking action. Only call the Skill tool to load using-tungnt-ai-skills if that content is missing from your context."
    escaped=$(escape_for_json "$session_context")
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
    exit 0
fi

# Copilot / Cursor / others: nothing persists, require explicit reload with bootstrap summary
bootstrap_summary="Before responding or taking action, you MUST call the Skill tool to load using-tungnt-ai-skills and follow its routing rules.

Skill tool usage:
  Skill name: using-tungnt-ai-skills
  This loads the bootstrap skill which routes to the right workflow skill.

Routing rules (from using-tungnt-ai-skills):
1. User instructions win
2. tungnt-ai-skills skills take priority
3. Default assistant behavior last

Process skills (choose one):
- investigation: bug tracing, incident analysis
- quick-dev: trivial, low-risk changes (<30 min)
- brainstorming: design exploration before creative work
- writing-plans: turn specs into implementation plans
- executing-plans: execute written plans with checkpoints
- requesting-code-review / receiving-code-review
- finishing-a-development-branch: verify DoD, handle merge

Domain skills (support brainstorming):
- api-design: REST/HTTP API contracts
- security-and-hardening: auth, secrets, OWASP, DevSecOps
- ui-ux-pro-max: design intelligence, design systems

Then invoke whichever skill it selects."

escaped=$(escape_for_json "$bootstrap_summary")
printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
exit 0