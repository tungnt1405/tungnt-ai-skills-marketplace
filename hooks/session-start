#!/usr/bin/env bash
# SessionStart hook for tungnt-ai-skills

set -euo pipefail

# Determine plugin root directory.
# Splits $0 on its last / or \ (run-hook.cmd's cmd half passes a Windows
# path), with no separator meaning the current directory. This avoids
# dirname because a SessionStart:startup hook can run with a broken/empty
# PATH (anthropics/claude-code#43127) before any PATH-repairing sibling hook
# in the same startup batch takes effect.
#
# No command substitution or pipe runs in this script: each one forks, and a
# fork costs tens of milliseconds under Git Bash on Windows. The paths stay
# relative to the current directory, which is all the file read below needs.
case "$0" in
  */*|*\\*) SCRIPT_DIR="${0%[/\\]*}" ;;
  *) SCRIPT_DIR="." ;;
esac
PLUGIN_ROOT="${SCRIPT_DIR}/.."

# Check if legacy skills directory exists and build warning
warning_message=""
legacy_skills_dir="${HOME}/.config/tungnt-ai-skills/skills"
if [ -d "$legacy_skills_dir" ]; then
    warning_message="\n\n<important-reminder>IN YOUR FIRST REPLY AFTER SEEING THIS MESSAGE YOU MUST TELL THE USER: WARNING: tungnt-ai-skills now uses Claude Code's skills system. Custom skills in ~/.config/tungnt-ai-skills/skills will not be read. Move custom skills to ~/.claude/skills instead. To make this message go away, remove ~/.config/tungnt-ai-skills/skills</important-reminder>"
fi

# Read using-tungnt-ai-skills content with the read builtin (no cat, for the same
# PATH-independence reason, and no $(< file) subshell). read returns 1 at end
# of file, hence || true; the loop drops trailing newlines as $(< file) did.
skill_md="${PLUGIN_ROOT}/skills/using-tungnt-ai-skills/SKILL.md"
using_tungnt_ai_skills_content="Error reading using-tungnt-ai-skills skill"
if [ -r "$skill_md" ]; then
  IFS= read -r -d '' using_tungnt_ai_skills_content < "$skill_md" || true
  while [[ $using_tungnt_ai_skills_content == *$'\n' ]]; do
    using_tungnt_ai_skills_content="${using_tungnt_ai_skills_content%$'\n'}"
  done
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces. The result
# goes to a named variable via printf -v, so no $(...) subshell is needed.
escape_for_json() {
    local s="$1"
    local out_var="$2"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf -v "$out_var" '%s' "$s"
}

escape_for_json "$using_tungnt_ai_skills_content" using_tungnt_ai_skills_escaped
escape_for_json "$warning_message" warning_escaped

if [ -f "${PLUGIN_ROOT}/hooks/framework-skills-hook" ]; then
    privacy_prompt_content=$(bash "${PLUGIN_ROOT}/hooks/framework-skills-hook" 2>&1 || echo "Error generating privacy prompt")
    escape_for_json "$privacy_prompt_content" privacy_prompt_escaped
else
    privacy_prompt_escaped=""
fi

session_context="<EXTREMELY_IMPORTANT>\nYou have tungnt-ai-skills.\n\n**Below is the full content of your bootstrap skill (\`using-tungnt-ai-skills\`). Read it first. For all other skills, use the 'Skill' tool:**\n\n${using_tungnt_ai_skills_escaped}\n\n${warning_escaped}\n\n${privacy_prompt_escaped}\n</EXTREMELY_IMPORTANT>"
copilot_context="Before responding or taking action, you MUST call the skill tool to load using-tungnt-ai-skills and follow it. Then call the relevant skill it selects. For creative coding work, this means calling brainstorming before writing code."

plugin_data_dir="${COPILOT_PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-${TMPDIR:-/tmp}/tungnt-ai-skills}}"
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  platform="cursor"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  platform="claude"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  platform="muse"
elif [ -n "${COPILOT_CLI:-}" ] || [ -n "${COPILOT_PLUGIN_ROOT:-}" ]; then
  platform="copilot"
else
  platform="unknown"
fi
{
  mkdir -p "$plugin_data_dir"
  printf '%s sessionStart platform=%s pid=%s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$platform" "$$" >> "$plugin_data_dir/session-start.log"
} 2>/dev/null || true

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
# Muse sets MUSE_PLUGIN_ROOT and expects additionalContext (SDK standard).
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
#
# emit_json absorbs EPIPE without a pipe through `cat`. On Windows + Git
# Bash, the harness can close the hook's stdout before printf finishes, and
# Git Bash's printf reports that EPIPE as "printf: write error: Permission
# denied", which `set -euo pipefail` would let escape as a startup diagnostic
# every session. SIGPIPE is ignored so other platforms see the same
# EPIPE error instead of a signal; the error message is dropped and the
# status ignored. No external command is involved, so a broken PATH
# changes nothing.
emit_json() {
  trap '' PIPE
  # shellcheck disable=SC2059 # every caller passes a literal format string
  printf "$@" 2>/dev/null || true
}

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  emit_json '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI/MUSE_PLUGIN_ROOT
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Muse sets MUSE_PLUGIN_ROOT — try Claude-style nested output for Muse Spark
  emit_json '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  emit_json '{\n  "additionalContext": "%s"\n}\n' "$copilot_context"
fi

exit 0
