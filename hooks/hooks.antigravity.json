{
  "tungnt-ai-skills-bootstrap": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "hooks/run-hook.cmd antigravity-pre-invocation",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/run-hook.cmd user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}